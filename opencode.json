{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "UnityMCP": {
        "type": "local",
        "command": [
            "uvx",
            "--from",
            "mcpforunityserver",
            "mcp-for-unity",
            "--transport",
            "stdio"
        ],
        "environment": {
            "UNITY_MCP_SKIP_STARTUP_CONNECT": "1"
        }
      }
    }
  }
}
